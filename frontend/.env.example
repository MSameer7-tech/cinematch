# Supabase (Public Client Keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# TMDB (Public Read Access)
VITE_TMDB_TOKEN=your-tmdb-read-access-token
VITE_TMDB_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_IMAGE_URL=https://image.tmdb.org/t/p
VITE_TMDB_API=your-tmdb-api-key

# Backend API URL (Render service URL + /api in production; leave unset in local dev to use Vite proxy)
VITE_API_BASE_URL=https://your-render-service.onrender.com/api
