# Allowed frontend origin(s) for CORS (comma-separated for multiple)
FRONTEND_URL=https://your-vercel-app.vercel.app

# Supabase (Server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# External APIs
TMDB_API_KEY=your-tmdb-api-key
GROQ_API_KEY=your-groq-api-key

# Admin Endpoint Protection
ADMIN_SECRET_KEY=your-strong-random-admin-secret

# Optional: only set if api.themoviedb.org is DNS-blocked on your network
# TMDB_DIRECT_IP=3.175.86.37
